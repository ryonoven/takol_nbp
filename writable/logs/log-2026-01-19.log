k":null,"kesimpulan6":null,"ntotalrisk":2,"nbelumkredit":2,"nbelumoperasional":2,"nbelumkepatuhan":2,"nbelumlikuiditas":2,"nbelumreputasi":null,"nbelumstratejik":null,"nbelumtotalrisk":2,"nprofilrisiko":"2","nprofilrisikobefore":"1","nfaktorprofilrisiko":"0.50","nfaktorprofilrisikobefore":"0.25","ntatakelola":"3","ntatakelolabefore":"2","nfaktortakol":"0.90","nfaktortakolbefore":"0.60","nrentabilitas":"1","nrentabilitasbefore":"1","nfaktorrentabilitas":"0.15","nfaktorrentabilitasbefore":"0.15","npermodalan":"1","npermodalanbefore":"3","nfaktorpermodalan":"0.30","nfaktorpermodalanbefore":"0.90","nkomposittks":1.8499999999999999,"nkomposittksbefore":1.9,"peringkatkomposittks":2,"peringkatkomposittksbefore":2}
