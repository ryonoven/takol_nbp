ilitasbefore":"1","nfaktorrentabilitas":"0.15","nfaktorrentabilitasbefore":"0.15","npermodalan":"1","npermodalanbefore":"3","nfaktorpermodalan":"0.30","nfaktorpermodalanbefore":"0.90","nkomposittks":1.8499999999999999,"nkomposittksbefore":1.9,"peringkatkomposittks":2,"peringkatkomposittksbefore":2}
